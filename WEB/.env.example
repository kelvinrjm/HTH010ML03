# ============================================================
# STOCKSENSE — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development

# Security & Authentication
# Generate a secure 32+ character random hex key for production (e.g. openssl rand -hex 32)
SECRET_KEY=stocksense-enterprise-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# Default local SQLite database file path:
DATABASE_PATH=data/smartstock.db

# Production PostgreSQL Connection (when deploying to cloud/container):
# DATABASE_URL=postgresql://stocksense_user:secure_password@localhost:5432/stocksense_db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Server Binding
HOST=127.0.0.1
PORT=8000
